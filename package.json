{
  "name": "backcode-runner",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "connect": "tsc && node dist/connect.js",
    "dev": "tsx src/index.ts",
    "all": "tsc && node dist/all.js"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "firebase": "^13.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "description": "Runner local de Backcode: escucha las tareas que aceptas en la app y las implementa con Claude Code en una rama propia.",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
