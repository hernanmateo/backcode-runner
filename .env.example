# ─────────────────────────────────────────────────────────────────────────────
# Backcode runner: copia este fichero a .env, rellénalo y protégelo:
#   cp .env.example .env && chmod 600 .env
# Un .env = un proyecto. Para varios proyectos: .env.web, .env.api… y `npm start -- --env .env.web`
# ─────────────────────────────────────────────────────────────────────────────

# Firebase de Backcode (configuración web pública; te la da el admin de tu grupo)
BACKCODE_FIREBASE_API_KEY=
BACKCODE_FIREBASE_AUTH_DOMAIN=
BACKCODE_FIREBASE_PROJECT_ID=
BACKCODE_FIREBASE_STORAGE_BUCKET=
BACKCODE_FUNCTIONS_REGION=us-central1

# 🔐 Tu runner key (app → Proyecto → Conectar mi Claude Code → Generar llave). Es personal: no la compartas.
BACKCODE_RUNNER_KEY=

# Proyecto de la app que escucha este runner (app → grupo → proyecto → ID)
BACKCODE_PROJECT_ID=

# Repositorio local donde se implementan las tareas que aceptes
BACKCODE_REPO_PATH=~/Projects/mi-repo
BACKCODE_BASE_BRANCH=main
BACKCODE_REMOTE=origin
# Dónde abrir los PR: github (con `gh`) · bitbucket (con API token, abajo) · push-only (solo sube la rama)
BACKCODE_PULL_REQUEST=github
# Bitbucket: email de tu cuenta Atlassian + API token con scopes (id.atlassian.com → Seguridad → API tokens, app Bitbucket).
# `npm run connect` te los pide si eliges Bitbucket. Se quedan en este ordenador; Claude no los ve.
BACKCODE_BITBUCKET_EMAIL=
BACKCODE_BITBUCKET_TOKEN=

# Límites por tarea
BACKCODE_MAX_TURNS=80
BACKCODE_MAX_BUDGET_USD=5
BACKCODE_TIMEOUT_MINUTES=45
BACKCODE_MAX_ATTEMPTS=2
# Modelo de Claude Code si la tarea no trae uno (en la app cada tarea elige Auto = el sugerido por la IA, o uno fijo).
# Vacío = el de tu configuración de Claude Code.
BACKCODE_MODEL=

# Mapa del proyecto: al arrancar, Claude (solo lectura, modelo barato) resume tu repo para que la IA
# que prepara los encargos lo conozca. Se regenera como mucho una vez al día si cambia la rama base.
BACKCODE_KNOWLEDGE=auto
BACKCODE_KNOWLEDGE_MODEL=haiku

# Seguridad: dominios a los que pueden conectarse los comandos del agente (separados por comas)
BACKCODE_ALLOWED_DOMAINS=registry.npmjs.org
# Rutas extra que el agente no puede modificar (regex sobre la ruta relativa, separadas por comas)
BACKCODE_PROTECTED_PATHS=

# Solo desarrollo: 1 = usar los emuladores locales de Firebase
BACKCODE_USE_EMULATORS=0
